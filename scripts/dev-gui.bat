@echo off
rem ============================================================================
rem  dev-gui.bat - build and launch cvewatch-gui against an isolated dev env
rem
rem  Usage: scripts\dev-gui.bat [reset] [release] [noseed]
rem    reset    delete the dev env (.dev\) and recreate it
rem             (never touches Windows Credential Manager)
rem    release  build with --release (default: debug)
rem    noseed   do not import the sample inventory on first setup
rem
rem  Dev env:
rem    config     .dev\cvewatch.toml (data_dir = .dev\data, separate from real data)
rem    inventory  tests\fixtures\inventory_basic.xlsx (6 assets)
rem    logs       .dev\data\logs\
rem
rem  Note: the DB key lives in Credential Manager under the fixed service
rem  "cvewatch", so the dev env shares the key with the real env.
rem  ensure_database only reuses an existing key; it never overwrites it.
rem
rem  Keep this file ASCII-only: cmd parses batch files incrementally and
rem  misreads multi-byte UTF-8 text when the code page differs.
rem ============================================================================
setlocal EnableExtensions

for %%I in ("%~dp0..") do set "ROOT=%%~fI"
set "DEV_DIR=%ROOT%\.dev"
set "DEV_CONFIG=%DEV_DIR%\cvewatch.toml"
set "DEV_DATA=%DEV_DIR%\data"
set "SEED_INVENTORY=%ROOT%\tests\fixtures\inventory_basic.xlsx"
set "PROFILE=debug"
set "CARGO_PROFILE_FLAG="
set "DO_RESET="
set "NO_SEED="

:parse_args
if "%~1"=="" goto args_done
if /i "%~1"=="reset"   (set "DO_RESET=1" & shift & goto parse_args)
if /i "%~1"=="release" (set "PROFILE=release" & set "CARGO_PROFILE_FLAG=--release" & shift & goto parse_args)
if /i "%~1"=="noseed"  (set "NO_SEED=1" & shift & goto parse_args)
if /i "%~1"=="help"    goto usage
if /i "%~1"=="-h"      goto usage
if /i "%~1"=="/?"      goto usage
echo [ERROR] Unknown argument: %~1
goto usage_error

:args_done
set "EXE_DIR=%ROOT%\target\%PROFILE%"
set "CLI_EXE=%EXE_DIR%\cvewatch.exe"
set "GUI_EXE=%EXE_DIR%\cvewatch-gui.exe"

where cargo >nul 2>&1 || (echo [ERROR] cargo not found. Install the Rust MSVC toolchain first. & exit /b 1)

rem SQLCipher's vendored OpenSSL needs Strawberry Perl, not Git for Windows' MSYS perl.
if not defined PERL if exist "C:\Strawberry\perl\bin\perl.exe" set "PERL=C:\Strawberry\perl\bin\perl.exe"

rem Log filter: debug for project crates, warn for third-party (unless CVEWATCH_LOG is set).
if not defined CVEWATCH_LOG set "CVEWATCH_LOG=warn,cvewatch=debug,cvewatch_core=debug,cvewatch_frontend=debug,cvewatch_gui=debug"

rem --- 1. Build (GUI sync/import/schedule need cvewatch.exe in the same folder) ---
echo [1/3] Building cvewatch and cvewatch-gui (%PROFILE%) ...
pushd "%ROOT%"
cargo build %CARGO_PROFILE_FLAG% -p cvewatch -p cvewatch-gui
set "BUILD_RC=%ERRORLEVEL%"
popd
if not "%BUILD_RC%"=="0" (echo [ERROR] Build failed, exit code %BUILD_RC%. & exit /b %BUILD_RC%)

rem --- 2. Prepare the dev env --------------------------------------------------
if not defined DO_RESET goto reset_done
echo [2/3] Resetting dev env: deleting "%DEV_DIR%"
if exist "%DEV_DIR%" rmdir /s /q "%DEV_DIR%"
if exist "%DEV_DIR%" (echo [ERROR] Could not delete the dev env. Close any cvewatch-gui using it and retry. & exit /b 1)
:reset_done

if not exist "%DEV_DIR%" mkdir "%DEV_DIR%" || exit /b 1
rem No ( ) block here: a ")" in the path, e.g. "Program Files (x86)", would end it early.
if exist "%DEV_CONFIG%" goto config_ready
>"%DEV_CONFIG%"  echo # Dev config generated by scripts\dev-gui.bat (editable; deleted by "reset")
>>"%DEV_CONFIG%" echo data_dir = '%DEV_DATA%'
:config_ready

if exist "%DEV_DATA%\cvewatch.db" (
    echo [2/3] Reusing existing dev env: "%DEV_DIR%"
    goto launch
)

echo [2/3] Creating dev env: "%DEV_DIR%"
"%CLI_EXE%" --config "%DEV_CONFIG%" init
if errorlevel 1 (echo [ERROR] cvewatch init failed, exit code %ERRORLEVEL%. & exit /b 1)

if defined NO_SEED goto launch
if not exist "%SEED_INVENTORY%" (echo [WARN] Sample inventory not found, skipping import: "%SEED_INVENTORY%" & goto launch)
echo       Importing sample inventory inventory_basic.xlsx ...
"%CLI_EXE%" --config "%DEV_CONFIG%" asset import "%SEED_INVENTORY%"
if errorlevel 1 echo [WARN] Sample inventory import failed, exit code %ERRORLEVEL%. Launching anyway.

rem --- 3. Launch the GUI -------------------------------------------------------
:launch
echo [3/3] Launching cvewatch-gui (this window shows the exit code when it closes)
echo       config: "%DEV_CONFIG%"
echo       logs  : "%DEV_DATA%\logs"
start "" /wait "%GUI_EXE%" --config "%DEV_CONFIG%"
set "GUI_RC=%ERRORLEVEL%"
echo cvewatch-gui exited with code %GUI_RC%.
exit /b %GUI_RC%

:usage
echo Usage: scripts\dev-gui.bat [reset] [release] [noseed]
echo   reset    delete the dev env (.dev\) and recreate it
echo   release  build with --release (default: debug)
echo   noseed   do not import the sample inventory on first setup
exit /b 0

:usage_error
echo Usage: scripts\dev-gui.bat [reset] [release] [noseed]
exit /b 2
